# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=gdec_tokens

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Microsoft OAuth
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_CALLBACK_URL=http://localhost:3000/api/auth/microsoft/callback
MICROSOFT_TENANT=common

# Microsoft Calendar (Outlook) integration — reuses the app registration above.
# Requires delegated Graph scopes: Calendars.ReadWrite, OnlineMeetings.ReadWrite, offline_access.
MICROSOFT_CALENDAR_CALLBACK_URL=http://localhost:3000/api/calendar/microsoft/callback
# Secret used to encrypt stored calendar OAuth tokens at rest (any long random string).
# Falls back to JWT_SECRET if unset; set a dedicated value in production.
CALENDAR_TOKEN_ENC_KEY=change-me-to-a-long-random-string

# AI Chat (Anthropic Claude) — server-side LLM for the chat assistant.
# Leave unset to disable; POST /api/chat returns 503 until configured.
ANTHROPIC_API_KEY=your-anthropic-api-key
# Defaults to claude-haiku-4-5 (cheapest). Other options: claude-sonnet-4-6, claude-opus-4-8.
# ANTHROPIC_MODEL=claude-haiku-4-5

# Application
PORT=3000
NODE_ENV=development
API_PREFIX=api

# Timezone the business operates in. Coach availability and session slots are
# stored as bare wall clocks ("9am in the office"), so this is what resolves them
# to real instants — leave it alone unless the company relocates.
#
# Do NOT also set TZ to this. The database session is UTC, and the process
# timezone changes how naive timestamps are read back; pinning the process to
# Asia/Manila once made every stored timestamp render 8 hours off. Timezone
# handling is explicit in code (common/utils/timezone.ts) precisely so the
# process timezone doesn't matter.
BUSINESS_TIME_ZONE=Asia/Manila
